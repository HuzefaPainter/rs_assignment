<div id="<%= dom_id activity %>">
  <p>
    <strong>Title:</strong>
    <%= activity.title %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= activity.description %>
  </p>

  <p>
    <strong>Duration (in seconds):</strong>
    <%= activity.duration%>
  </p>

  <p>
    <strong>Frequency:</strong>
    <%= activity.frequency %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= activity.category_id%>
  </p>

</div>
